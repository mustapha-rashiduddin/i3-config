set $mod Mod4
font pango:monospace 14
#font pango:Ac437 IBM VGA 8x16 18

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id feh --bg-fill /run/current-system/sw/share/backgrounds/nixos/nix-wallpaper-simple-dark-gray.png

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet
exec --no-startup-id pnmixer
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer --allow-boost -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer --allow-boost -d 5
bindsym XF86AudioMute exec --no-startup-id pamixer -t
# Screen Brightness Control
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
# microphone
bindsym XF86AudioMicMute exec --no-startup-id pamixer --default-source -t

set $refresh_i3status killall -SIGUSR1 i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# kill focused window
bindsym $mod+r kill

# start dmenu (a program launcher)
#bindsym $mod+e exec --no-startup-id dmenu_run

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+g fullscreen toggle
bindsym $mod+b floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

set $ws1 "j"
set $ws2 "k"
set $ws3 "l"
set $ws4 ";"
set $ws5 "m"
set $ws6 ","
set $ws7 "."
set $ws8 "/"
#set $ws9 "a"
#set $ws10 "s"
#set $ws11 "d"
#set $ws12 "f"
#set $ws13 "z"
#set $ws14 "x"
#set $ws15 "c"
#set $ws16 "v"

# switch to workspace (the loadout slots; sweep the loadout and unload on any drift)
bindsym $mod+j workspace $ws1; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+k workspace $ws2; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+l workspace $ws3; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+semicolon workspace $ws4; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+m workspace $ws5; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+comma workspace $ws6; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+period workspace $ws7; exec --no-startup-id ~/.config/i3/loadout.py heal
bindsym $mod+slash workspace $ws8; exec --no-startup-id ~/.config/i3/loadout.py heal

#bindsym $mod+a workspace $ws9
#bindsym $mod+s workspace $ws10
#bindsym $mod+d workspace $ws11
#bindsym $mod+f workspace $ws12
#bindsym $mod+z workspace $ws13
#bindsym $mod+x workspace $ws14
#bindsym $mod+c workspace $ws15
#bindsym $mod+v workspace $ws16

# move focused container to workspace
bindsym $mod+Mod1+j move container to workspace $ws1
bindsym $mod+Mod1+k move container to workspace $ws2
bindsym $mod+Mod1+l move container to workspace $ws3
bindsym $mod+Mod1+semicolon move container to workspace $ws4
bindsym $mod+Mod1+m move container to workspace $ws5
bindsym $mod+Mod1+comma move container to workspace $ws6
bindsym $mod+Mod1+period move container to workspace $ws7
bindsym $mod+Mod1+slash move container to workspace $ws8

#bindsym $mod+Mod1+a move container to workspace $ws9
#bindsym $mod+Mod1+s move container to workspace $ws10
#bindsym $mod+Mod1+d move container to workspace $ws11
#bindsym $mod+Mod1+f move container to workspace $ws12
#bindsym $mod+Mod1+z move container to workspace $ws13
#bindsym $mod+Mod1+x move container to workspace $ws14
#bindsym $mod+Mod1+c move container to workspace $ws15
#bindsym $mod+Mod1+v move container to workspace $ws16

# Rename window
bindsym $mod+n exec --no-startup-id ~/.config/i3/rename-window.sh

# Cycle through windows forward
bindsym $mod+Tab focus right

# Cycle through windows backward
bindsym $mod+Shift+Tab focus left

# reload the configuration file
bindsym $mod+shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+y restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bar {
        id sysbar
        position top
        workspace_buttons no
        binding_mode_indicator no
        status_command /home/saifr/.config/i3/status.py
        tray_output primary
}

bar {
        id wsbar
        position bottom
        workspace_buttons no
        binding_mode_indicator no
        status_command /home/saifr/.config/i3/ws.py
        tray_output none
}

bindsym $mod+e exec --no-startup-id env PATH="$HOME/.config/i3/chrome-sync:$PATH" dmenu_run
bindsym $mod+q exec --no-startup-id ~/.config/i3/launch-chrome-default
bindsym $mod+o exec --no-startup-id $HOME/.config/config-manager/st -e mksh
bindsym $mod+u exec --no-startup-id ghostty -e fish
bindsym $mod+i exec --no-startup-id emacs

# Full screenshot
bindsym Print exec --no-startup-id maim "/home/$USER/screenshots/screenshot_$(date +%s).png"
# Cropped screenshot
bindsym Shift+Print exec --no-startup-id maim -s "/home/$USER/screenshots/screenshot_$(date +%s).png"

default_border pixel 1
